[node name="IlMacchinista" type="CharacterBody2D" parent="Entita" unique_id=1603675867]
position = Vector2(240, 736)
script = ExtResource("13_m6brk")
display_name = "Il Macchinista"
lines = PackedStringArray("Sei quello senza faccia, eh? Benvenuto in piazza. E\' tutta dipinta: non appoggiarti ai palazzi.", "Dove il pavimento e\' pieno di ritagli e vernice, nelle quinte, ci si imbatte in qualcuno. Comparse, macchie che si staccano dai fondali. Si recita, si vince qualche biglietto.", "I biglietti li spendi alla baracca del Burattinaio. E se ti senti a pezzi, nel tuo camerino c\'e\' il letto. Lo sanno tutti: il letto del camerino rimette in piedi.")
look = "npc"
tint = Color(0.9, 0.85, 1, 1)
facing = Vector2(1, 0)

